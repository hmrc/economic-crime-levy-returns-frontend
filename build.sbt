import play.sbt.routes.RoutesKeys
import scoverage.ScoverageKeys
import uk.gov.hmrc.DefaultBuildSettings

val appName = "economic-crime-levy-returns-frontend"

ThisBuild / scalaVersion := "3.3.7"
ThisBuild / majorVersion := 0

lazy val root = (project in file("."))
  .enablePlugins(PlayScala, SbtDistributablesPlugin)
  .disablePlugins(JUnitXmlReportPlugin) //Required to prevent https://github.com/scalatest/scalatest/issues/1427
  .settings(inConfig(Test)(testSettings): _*)
  .settings(inThisBuild(buildSettings))
  .settings(scoverageSettings: _*)
  .settings(scalaCompilerOptions: _*)
  .settings(
    name := appName,
    RoutesKeys.routesImport ++= Seq(
      "uk.gov.hmrc.economiccrimelevyreturns.models._",
      "uk.gov.hmrc.play.bootstrap.binders.RedirectUrl"
    ),
    TwirlKeys.templateImports ++= Seq(
      "play.twirl.api.HtmlFormat",
      "uk.gov.hmrc.govukfrontend.views.html.components._",
      "uk.gov.hmrc.hmrcfrontend.views.html.components._",
      "uk.gov.hmrc.hmrcfrontend.views.html.helpers._",
      "uk.gov.hmrc.hmrcfrontend.views.config._",
      "uk.gov.hmrc.economiccrimelevyreturns.views.ViewUtils._",
      "uk.gov.hmrc.economiccrimelevyreturns.models._",
      "uk.gov.hmrc.economiccrimelevyreturns.controllers.routes._",
      "uk.gov.hmrc.economiccrimelevyreturns.viewmodels.govuk.all._"
    ),
    PlayKeys.playDefaultPort := 14002,
    libraryDependencies ++= AppDependencies(),
    retrieveManaged := true,
    (update / evictionWarningOptions).withRank(KeyRanks.Invisible) :=
      EvictionWarningOptions.default.withWarnScalaVersionEviction(false),
    // concatenate js
    Concat.groups := Seq(
      "javascripts/application.js" ->
        group(
          Seq(
            "javascripts/prevent-resubmit-warning.js",
            "javascripts/print-dialogue.js",
            "javascripts/onload.js"
          )
        )
    )
  )

lazy val it = (project in file("it"))
  .enablePlugins(PlayScala)
  .dependsOn(root % "compile->compile;test->test")
  .settings(
    DefaultBuildSettings.itSettings(),

    libraryDependencies ++= AppDependencies.itDependencies,

    Test / resourceDirectories += baseDirectory.value / "resources",

    Test / fork := true,

    Test / parallelExecution := false
  )

lazy val buildSettings = Def.settings(
  scalafmtOnCompile := true,
  useSuperShell := false
)

lazy val testSettings: Seq[Def.Setting[_]] = Seq(
  unmanagedSourceDirectories := Seq(
    baseDirectory.value / "test",
    baseDirectory.value / "test-common"
  ),
  fork := true
)

val excludedScoveragePackages: Seq[String] = Seq(
  "<empty>",
  "Reverse.*",
  ".*handlers.*",
  ".*components.*",
  "uk.gov.hmrc.BuildInfo",
  "app.*",
  "prod.*",
  ".*Routes.*",
  "testOnly.*",
  "testOnlyDoNotUseInAppConf.*",
  ".*viewmodels.govuk.*",
  ".*viewmodels.*",
  ".*testonly*.",
  ".*Module",
  ".*template.*",
  ".*viewmodels.govuk.*",
  ".*viewmodels.*"
)

val scoverageSettings: Seq[Setting[_]] = Seq(
  ScoverageKeys.coverageExcludedFiles := excludedScoveragePackages.mkString(";"),
  ScoverageKeys.coverageMinimumStmtTotal := 86,
  ScoverageKeys.coverageFailOnMinimum := true,
  ScoverageKeys.coverageHighlighting := true
)

val scalaCompilerOptions: Def.Setting[Task[Seq[String]]] =
  scalacOptions ++= Seq(
    // Play routes generated Scala
    "-Wconf:msg=unused import&src=.*/conf/.*:s",
    "-Wconf:msg=unused import&src=.*/routes/.*:s",

    // Twirl generated Scala
    "-Wconf:msg=unused import&src=.*\\.template\\.scala:s",

    // Unused pattern variables generated by Play routes
    "-Wconf:msg=unused pattern variable&src=.*/conf/.*:s",
    "-Wconf:msg=unused pattern variable&src=.*/routes/.*:s",

    // Unused private members generated by Play routes
    "-Wconf:msg=unused private member&src=.*/conf/.*:s",
    "-Wconf:msg=unused private member&src=.*/routes/.*:s",

    "-feature"
  )
addCommandAlias("runAllChecks", ";clean;compile;scalafmtCheckAll;coverage;test;it:test;scalastyle;coverageReport")
